{
  "expo": {
    "name": "Handshake",
    "slug": "handshake",
    "version": "0.1.1",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudomarc.handshake"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0c0f"
      },
      "package": "com.sudomarc.handshake"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "./plugins/handshake-call-audio/plugin.js"
    ],
    "scheme": "handshake",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ebe22f19-e5bf-419b-bc97-f0c033e98809"
      }
    },
    "owner": "marco_polo"
  }
}
