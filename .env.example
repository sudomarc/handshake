# Copy to .env.local and fill in real values. Never commit .env.local.

# Featherless AI (OpenAI-compatible API)
# Docs: https://featherless.ai/docs/quickstart-guide
# Get a key: https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3.8-27B

# Server secret used to derive pair secrets (required by the codes module)
# Generate one with: openssl rand -hex 32
PAIR_DERIVATION_KEY=