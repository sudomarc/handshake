# Copy to .env.local and fill in real values. Never commit .env.local.

# Featherless AI (OpenAI-compatible API)
# Docs: https://featherless.ai/docs/quickstart-guide
# Get a key: https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3.8-27B

# Server secret used to derive pair secrets (required by the codes module)
# Generate one with: openssl rand -hex 32
PAIR_DERIVATION_KEY=

# Upstash Redis (optional) - enables production-ready distributed trust storage
# Get a free database at https://upstash.com (free tier: 10K req/day, 256MB)
# When set, trust enrollments, sessions, and nonces persist across serverless restarts
# and are consistent across multiple instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative: local file-backed persistence (optional)
# TRUST_STORE_PATH=./data/trust-store.json